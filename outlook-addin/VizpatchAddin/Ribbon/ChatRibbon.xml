<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ribbon-XML des Vizpatch-Add-ins (RESEARCH.md Pattern 1). Ein Toggle-Button
  im Explorer-Ribbon (TabMail) blendet die "Vizpatch-Chat"-Task-Pane ein/aus.
  Die Callback-Namen verweisen auf ChatRibbon.cs.

  Beschriftung: der Button heisst "Chat", die GRUPPE heisst "Vizpatch" — so
  traegt jede der beiden Zeilen eine eigene Information, wie bei den
  Outlook-eigenen Gruppen ("Laut vorlesen" in "Sprache", "Adressbuch" in
  "Suchen").

  KEIN showLabel="false": bei size="large" ignoriert Office das Attribut
  (grosse Buttons zeigen ihr Label immer, es wirkt nur bei size="normal").
  Der erste Versuch am 2026-08-24 setzte es trotzdem — Ergebnis war das Logo
  MIT Beschriftung, also "Vizpatch" zweimal untereinander. Wer den Text
  wirklich weghaben will, muss den Button auf size="normal" verkleinern; dann
  bleibt nur ein 16-px-Icon.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad" loadImage="OnLoadImage">
  <ribbon>
    <tabs>
      <tab idMso="TabMail" >
        <group id="vizpatchGroup" label="Vizpatch">
          <toggleButton id="vizpatchChatToggle"
                        label="Chat"
                        size="large"
                        image="vizpatchLogo"
                        onAction="OnToggleChat"
                        getPressed="GetChatPressed"
                        screentip="Vizpatch-Chat ein-/ausblenden"
                        supertip="Blendet den Vizpatch-Chat-Bereich (Custom Task Pane) rechts im Outlook-Fenster ein oder aus." />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
